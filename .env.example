DISCORD_TOKEN=replace-with-your-discord-bot-token
# Optional: set this to register commands in one server instead of globally.
# DISCORD_GUILD_ID=your-discord-server-id
# Optional default channels; administrators can override them in Discord.
# DISCORD_PRACTICE_CHANNEL_ID=replace-with-your-practice-channel-id
# DISCORD_TIPS_CHANNEL_ID=replace-with-your-tips-channel-id

POSTGRES_DB=aws_clf_bot
POSTGRES_USER=aws_clf_bot
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aws_clf_bot:replace-with-a-strong-url-safe-password@localhost:5432/aws_clf_bot
