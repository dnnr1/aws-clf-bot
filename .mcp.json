{
  "mcpServers": {
    "discord": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "@discord-mcp/cli@0.34.1",
        "serve"
      ],
      "env": {
        "DISCORD_TOKEN": "${DISCORD_TOKEN}",
        "ALLOWED_GUILDS": "${DISCORD_GUILD_ID}",
        "MCP_CATEGORIES": "messages",
        "MCP_TOOL_SURFACE": "progressive",
        "MCP_WRITE_MODE": "preview",
        "MCP_ACCESS_MODE": "enforce"
      },
      "tools": [
        "mcp_tools_search",
        "mcp_tools_read",
        "mcp_tools_write"
      ]
    }
  }
}
